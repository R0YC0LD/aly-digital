# Spotify Web API (server-only — NEVER prefix with NEXT_PUBLIC_)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=TR
SPOTIFY_REVALIDATE_SECONDS=21600

# Instagram Graph API (optional — leave empty for local media fallback)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# Site
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DEPLOY_TARGET=vercel
NEXT_PUBLIC_BASE_PATH=

# GitHub Pages mirror mode:
# NEXT_PUBLIC_DEPLOY_TARGET=github-pages
# NEXT_PUBLIC_BASE_PATH=/aly-dijital-evren
# NEXT_PUBLIC_SITE_URL=https://R0YC0LD.github.io/aly-dijital-evren
