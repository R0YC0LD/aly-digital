# ============================================================
# Spotify secrets — SADECE sunucu / build tarafında kullanılır.
# Asla VITE_ ile prefixleme. Frontend bundle'a girmez.
# ============================================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# api  → Vercel serverless /api/spotify
# static → GitHub Pages public/data/spotify.json
VITE_DATA_MODE=api

# Canonical site URL (sonunda / olmadan), örn: https://aly.example.com
VITE_SITE_URL=

# GitHub Pages alt yolu için örn: /aly-digital/
# Vercel için genellikle /
VITE_BASE_PATH=/

# false ise metadata "resmî" iddiası taşımaz
VITE_SITE_IS_OFFICIAL=false
