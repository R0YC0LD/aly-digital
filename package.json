{
  "name": "aly-dijital-evren",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run verify:spotify && npm run verify:instagram && npm run verify:secrets",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:spotify": "node scripts/verify-spotify.mjs && node scripts/verify-single-tracks.mjs",
    "verify:instagram": "node scripts/verify-instagram.mjs",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "sync:spotify": "node scripts/sync-spotify.mjs",
    "sync:instagram": "node scripts/sync-instagram.mjs",
    "migrate:catalog": "node scripts/migrate-catalog.mjs",
    "purge:catalog": "node scripts/purge-contaminated-catalog.mjs",
    "build:singles": "node scripts/build-single-tracks.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run verify:spotify && npm run verify:instagram && npm run verify:secrets",
    "build:production": "npm run verify && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.8",
    "lucide-react": "^0.525.0",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
